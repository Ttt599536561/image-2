{$DOMAIN} {
	encode zstd gzip

	handle {
		reverse_proxy web:3000 {
			# Overwrite client input; only Caddy may establish the rate-limit IP.
			header_up X-Studio-Client-IP {remote_host}
		}
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
